+def metric_comparison(expected, actual, epsilon=1e-7):
+    """Check every ordered metric vertex; never relax original WGS84 equality."""
+    same_shape = (isinstance(actual, list) and len(expected) == len(actual)
+                  and all(len(a) == len(b) for a, b in zip(expected, actual)))
+    differences, maximum = [], 0.0
+    if same_shape:
+        for ring, (a, b) in enumerate(zip(expected, actual)):
+            for vertex, (p, q) in enumerate(zip(a, b)):
+                delta = [q[i] - p[i] for i in (0, 1)]
+                maximum = max(maximum, *(abs(v) for v in delta))
+                if any(delta):
+                    differences.append({'ring': ring, 'vertex': vertex, 'expected': p,
+                                        'native': q, 'deltaMeters': delta})
+    return {'matches': same_shape and maximum <= epsilon, 'epsilonMeters': epsilon,
+            'sameOrderedRingShape': same_shape, 'maximumCoordinateDeltaMeters': maximum,
+            'differentVertices': differences}
+
